{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "react"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "ESNext.Disposable"
    ]
  },
  "include": [
    "src",
    "tests"
  ]
}
