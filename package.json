{
  "name": "@local/dsh-session-groups",
  "version": "0.2.0",
  "private": true,
  "description": "Persistent group chats for coordinating DeepSeek Harness sessions",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-file-upload"
      ]
    }
  },
  "scripts": {
    "bootstrap:local": "node scripts/bootstrap-local.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.0.0",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "zod": "4.4.3",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "react-dom": "^18.2.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VibeDev-Si/deepseek-harness-group-messages.git"
  }
}
